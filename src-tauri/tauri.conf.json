{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focusday",
  "version": "1.3.4",
  "identifier": "app.focusday.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run bundle",
    "beforeBuildCommand": "npm run bundle -- --minify"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Focusday",
        "width": 1360,
        "height": 880,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#07080b",
        "url": "focusday.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Focusday",
    "shortDescription": "ADHD-friendly дневник задач",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
