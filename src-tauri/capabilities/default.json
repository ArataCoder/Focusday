{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права для главного окна, виджета, быстрого захвата и котика-компаньона",
  "windows": [
    "main",
    "overlay",
    "quick",
    "buddy"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:allow-open"
  ]
}